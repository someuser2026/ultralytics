#!/bin/bash

#PBS -l select=1:ncpus=1:mem=32gb
#PBS -l walltime=01:00:00
#PBS -m ae

# Deferred managed runs are submitted only after batch completion is verified.
set -euo pipefail

if [[ -n "${SITE_PREDICT_CONTROL:-}" && -n "${SITE_PIPELINE_JOB_LOGGING:-}" ]]; then
    export SITE_PIPELINE_EXECUTION_LOGS="${SITE_PREDICT_CONTROL}/logs/executions/${SITE_PREDICT_NODE:?}"
    source "${SITE_PIPELINE_JOB_LOGGING}"
fi

if [[ -n "${SITE_PREDICT_CONTROL:-}" && -n "${SITE_PREDICT_ENV_SETUP:-}" ]]; then
    if [[ -n "${SITE_PIPELINE_JOB_LOGGING:-}" ]]; then
        site_pipeline_source "${SITE_PREDICT_ENV_SETUP}"
    else
        source "${SITE_PREDICT_ENV_SETUP}"
    fi
fi

cd "${PBS_O_WORKDIR:-$(pwd)}"
: "${CHECKPOINT:?CHECKPOINT is required}"
: "${SITE_NAME:?SITE_NAME is required}"
: "${IMG_DIR:?IMG_DIR is required}"
: "${SCRATCH:?SCRATCH is required}"
: "${EXPECTED_BATCHES:?EXPECTED_BATCHES is required}"
: "${EXPECTED_COUNT:?EXPECTED_COUNT is required}"

export MAMBA_EXE="${MAMBA_EXE:-/srv/scratch/z5428587/mamba/bin/micromamba}"
export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-/srv/scratch/z5428587/mamba}"

echo "Combining ${EXPECTED_BATCHES} batches for ${SITE_NAME}; job ${PBS_JOBID:-local}"
combine_args=(jobs/infer/combine_yolo_site_predict_json_batches.py)
if [[ -n "${SITE_PREDICT_CONTROL:-}" && -n "${SITE_PREDICT_OUTPUT_DIR:-}" ]]; then
    combine_args+=(--output-dir "${SITE_PREDICT_OUTPUT_DIR}")
else
    combine_args+=(--ckpt "${CHECKPOINT}" --site-name "${SITE_NAME}" --img-dir "${IMG_DIR}")
fi
combine_args+=(--expected-batches "${EXPECTED_BATCHES}" --expected-count "${EXPECTED_COUNT}")
if [[ -n "${SITE_PREDICT_CONTROL:-}" ]]; then
    "${MAMBA_EXE}" run -n "${SITE_PREDICT_ENVIRONMENT:-ultralytics_contrib}" "${SITE_PREDICT_PYTHON:?}" \
        jobs/infer/site_predict_job_control.py run-worker \
        "${SITE_PREDICT_CONTROL}" "${SITE_PREDICT_NODE:?}" "${SITE_PREDICT_ATTEMPT:?}" \
        -- "${SITE_PREDICT_PYTHON}" "${combine_args[@]}"
else
    "${MAMBA_EXE}" run -n ultralytics_contrib python3 "${combine_args[@]}"
fi
