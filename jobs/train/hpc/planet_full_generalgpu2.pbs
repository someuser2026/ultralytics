#!/bin/bash

#PBS -q civenggpu2
#PBS -l select=1:ncpus=6:ngpus=1:mem=32gb
#PBS -l walltime=11:00:00
#PBS -M z5428587@ad.unsw.edu.au
#PBS -m ae

set -euo pipefail

if [[ "${SOURCE_USER_SHELL_RC:-0}" == "1" ]]; then
    source ~/.bashrc 2>/dev/null || true
    source ~/.profile 2>/dev/null || true
fi

export MAMBA_EXE="${MAMBA_EXE:-/srv/scratch/z5428587/mamba/bin/micromamba}"
export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-/srv/scratch/z5428587/mamba}"

echo "Using micromamba from: ${MAMBA_EXE}"
echo "Root prefix: ${MAMBA_ROOT_PREFIX}"

__mamba_setup="$("${MAMBA_EXE}" shell hook --shell bash --root-prefix "${MAMBA_ROOT_PREFIX}" 2>/dev/null || true)"
if [ -n "${__mamba_setup}" ]; then
    eval "${__mamba_setup}"
    echo "✓ Micromamba shell hook initialized successfully"
else
    micromamba() { "${MAMBA_EXE}" "$@"; }
    echo "✓ Using micromamba function fallback"
fi
unset __mamba_setup

echo "========================================="
echo "Job started at: $(date)"
echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Job name: ${PBS_JOBNAME:-unknown}"
echo "Node: $(hostname)"
echo "Working directory: ${PBS_O_WORKDIR:-$(pwd)}"
echo "Initial Python: $(which python3)"
echo "Initial Python version: $(python3 --version 2>&1)"
echo "========================================="

cd "${PBS_O_WORKDIR:-$(pwd)}"
echo "Changed to working directory: $(pwd)"

is_nullish() {
    local value="${1:-}"
    local lower
    lower="$(printf '%s' "${value}" | tr '[:upper:]' '[:lower:]')"
    [[ -z "${value}" || "${lower}" == "null" || "${lower}" == "none" ]]
}

bool_string() {
    local value="${1:-}"
    local lower
    lower="$(printf '%s' "${value}" | tr '[:upper:]' '[:lower:]')"
    if [[ "${lower}" == "false" || "${lower}" == "0" || "${lower}" == "no" ]]; then
        printf 'False\n'
    else
        printf 'True\n'
    fi
}

append_arg() {
    local key="$1"
    local value="${2:-}"
    if ! is_nullish "${value}"; then
        yolo_args+=("${key}=${value}")
    fi
}

model_stem() {
    local stem
    stem="$(basename "$1")"
    stem="${stem%.*}"
    stem="${stem%-seg}"
    stem="${stem%-segment}"
    stem="${stem%-obb}"
    printf '%s\n' "${stem}"
}

resolve_run_name() {
    local mode="${experiment_mode:-auto}"
    local prefix="${experiment_prefix:-}"
    local stem dataset_dir
    stem="$(model_stem "${model_yaml}")"
    dataset_dir="$(basename "$(dirname "${data_yaml_path}")")"
    case "${mode}" in
        auto)
            printf '%s-%s\n' "${stem}" "${dataset_dir}"
            ;;
        experiment)
            if is_nullish "${prefix}"; then
                printf 'exp_%s\n' "$(date +%m%d_%H%M%S)"
            else
                printf 'exp_%s_%s\n' "$(date +%m%d_%H%M%S)" "${prefix}"
            fi
            ;;
        null)
            printf '\n'
            ;;
        timestamp)
            printf '%s-%s_%s\n' "${stem}" "${dataset_dir}" "$(date +%m%d_%H%M)"
            ;;
        *)
            printf '%s\n' "${mode}"
            ;;
    esac
}

task="${TASK:-}"
imgsz="${IMGSZ:-}"
model_yaml="${CONFIG_YAML:-}"
time="${TIME_FLOAT:-}"
epochs="${EPOCHS:-}"
device="${DEVICE:-}"
experiment_mode="${EXPERIMENT_MODE:-auto}"
experiment_prefix="${EXPERIMENT_PREFIX:-}"
overlap="${OVERLAP:-}"
keep_frac="${KEEP_FRAC:-}"
batch="${BATCH:-}"

weights="${CHECKPOINT:-}"
freeze="${FREEZE:-}"
unfreeze="${UNFREEZE:-}"
lora="${LORA:-}"
lora_rank="${LORA_RANK:-}"
lora_alpha="${LORA_ALPHA:-}"
lora_dropout="${LORA_DROPOUT:-}"
lora_layers="${LORA_LAYERS:-}"
lora_targets="${LORA_TARGETS:-}"
multispectral="${MULTISPECTRAL:-0}"
wandb="${WANDB:-true}"
project="${PROJECT:-}"
use_soft_ignore="${USE_SOFT_IGNORE:-}"
seed="${SEED:-0}"
sdice="${SDICE:-}"
sbce="${SBCE:-}"
slovhn="${SLOVHN:-}"
angle_mode="${ANGLE_MODE:-}"
use_land_water_input="${USE_LAND_WATER_INPUT:-}"
use_shoreline_input="${USE_SHORELINE_INPUT:-}"

clahe_p="${CLAHE_P:-}"
rand_gamma_p="${RAND_GAMMA_P:-}"
unsharp_p="${UNSHARP_P:-}"
edgeboost_p="${EDGEBOOST_P:-}"
homomorphic_p="${HOMOMORPHIC_P:-}"
gaussian_blur_p="${GAUSSIAN_BLUR_P:-}"
motion_blur_p="${MOTION_BLUR_P:-}"
additive_noise_p="${ADDITIVE_NOISE_P:-}"
multi_spec_noise_p="${MULTI_SPEC_NOISE_P:-}"

sobel_p="${SOBEL_P:-}"
canny_p="${CANNY_P:-}"
log_p="${LOG_P:-}"
structure_tensor_p="${STRUCTURE_TENSOR_P:-}"
lbp_p="${LBP_P:-}"
gaussian_pyramid_p="${GAUSSIAN_PYRAMID_P:-}"
laplacian_pyramid_p="${LAPLACIAN_PYRAMID_P:-}"
steerable_p="${STEERABLE_P:-}"
gabor_p="${GABOR_P:-}"
dog_p="${DOG_P:-}"
ridge_p="${RIDGE_P:-}"
water_indices_p="${WATER_INDICES_P:-}"

missing_params=()
is_nullish "${task}" && missing_params+=("TASK")
is_nullish "${imgsz}" && missing_params+=("IMGSZ")
is_nullish "${model_yaml}" && missing_params+=("CONFIG_YAML")
is_nullish "${device}" && missing_params+=("DEVICE")
is_nullish "${overlap}" && missing_params+=("OVERLAP")
is_nullish "${keep_frac}" && missing_params+=("KEEP_FRAC")
is_nullish "${batch}" && missing_params+=("BATCH")

if is_nullish "${time}" && is_nullish "${epochs}"; then
    echo "Error: Either TIME_FLOAT or EPOCHS must be provided"
    exit 1
fi

if is_nullish "${SCRATCH:-}"; then
    echo "Error: SCRATCH must be set"
    exit 1
fi

if [ "${#missing_params[@]}" -ne 0 ]; then
    echo "Error: Missing required environment variables: ${missing_params[*]}"
    exit 1
fi

echo "========================================="
echo "Critical Parameters:"
echo "  Task: ${task}"
echo "  Image size: ${imgsz}"
echo "  Model YAML: ${model_yaml}"
echo "  Time: ${time:-null}"
echo "  Epochs: ${epochs:-null}"
echo "  Device: ${device}"
echo "  Experiment mode: ${experiment_mode}"
echo "  Overlap: ${overlap}"
echo "  Keep fraction: ${keep_frac}"
echo "  Batch: ${batch}"
echo ""
echo "Optional Parameters:"
echo "  Weights: ${weights:-null}"
echo "  Freeze: ${freeze:-null}"
echo "  Unfreeze: ${unfreeze:-null}"
echo "  LoRA: ${lora:-false}"
echo "  LoRA rank: ${lora_rank:-null}"
echo "  LoRA alpha: ${lora_alpha:-null}"
echo "  LoRA dropout: ${lora_dropout:-null}"
echo "  LoRA layers: ${lora_layers:-null}"
echo "  LoRA targets: ${lora_targets:-null}"
echo "  Multispectral: ${multispectral}"
echo "  WandB: ${wandb}"
echo "  Project Name: ${project:-null}"
echo "  Use soft ignore boundary loss: ${use_soft_ignore:-null}"
echo "  Seed: ${seed}"
echo "========================================="

echo "Checking file existence:"
if [ ! -f "${model_yaml}" ]; then
    echo "Error: Model YAML file not found: ${model_yaml}"
    exit 1
fi
echo "✓ Model YAML found: ${model_yaml}"

if ! is_nullish "${weights}"; then
    if [ ! -f "${weights}" ]; then
        echo "Error: Weights file not found: ${weights}"
        exit 1
    fi
    echo "✓ Weights file found: ${weights}"
else
    echo "ℹ No weights file specified - will use model YAML"
fi

case "${multispectral}" in
    0)
        data_yaml_path="${SCRATCH}/data_processed/Global/Annotated/variants/${task}/planet_full_c${imgsz}_ov${overlap}_kf${keep_frac}_seed${seed}/data.yaml"
        echo "ℹ Using standard RGB dataset with only 100"
        ;;
    01)
        data_yaml_path="${SCRATCH}/data_processed/Global/Annotated/variants/${task}/planet_full_c${imgsz}_ov${overlap}_kf${keep_frac}_maxarea5000_seed${seed}/data.yaml"
        echo "ℹ Using standard RGB dataset (max area filtered)"
        ;;
    001)
        data_yaml_path="${SCRATCH}/data_processed/Global/Annotated/variants/${task}/planet_full_c${imgsz}_ov${overlap}_kf${keep_frac}_10075-multi_seed${seed}/data.yaml"
        echo "ℹ Using Planet RGB dataset with 100 and 75 as different classes"
        ;;
    002)
        data_yaml_path="${SCRATCH}/data_processed/Global/Annotated/variants/${task}/planet_full_c${imgsz}_ov${overlap}_kf${keep_frac}_all_seed${seed}/data.yaml"
        echo "ℹ Using Planet RGB dataset with 100, 75, 50 and 30 as different classes"
        ;;
    003)
        data_yaml_path="${SCRATCH}/data_processed/Global/Annotated/variants/${task}/planet_full_c${imgsz}_ov${overlap}_kf${keep_frac}_10075-single_seed${seed}/data.yaml"
        echo "ℹ Using Planet RGB dataset with 100 and 75 as single class"
        ;;
    004)
        data_yaml_path="${SCRATCH}/data_processed/Global/Annotated/variants/${task}/planet_full_c${imgsz}_ov${overlap}_kf${keep_frac}_all_soft_seed${seed}/data.yaml"
        echo "ℹ Using Planet RGB dataset with soft labels (single class + per-annotation probability)"
        ;;
    1)
        data_yaml_path="${SCRATCH}/data_processed/Global/Annotated/variants/${task}/planet_full_analytic_udm2_c${imgsz}_ov${overlap}_kf${keep_frac}_seed${seed}/data.yaml"
        echo "ℹ Using RGB + NIR dataset"
        ;;
    11)
        data_yaml_path="${SCRATCH}/data_processed/Global/Annotated/variants/${task}/planet_full_analytic_udm2_c${imgsz}_ov${overlap}_kf${keep_frac}_maxarea5000_seed${seed}/data.yaml"
        echo "ℹ Using RGB + NIR dataset (max area filtered)"
        ;;
    2)
        data_yaml_path="${SCRATCH}/data_processed/Global/Annotated/variants/${task}/planet_nearmap_c${imgsz}_ov${overlap}_kf${keep_frac}_seed${seed}/data.yaml"
        echo "ℹ Using Planet + Nearmap RGB dataset with 100 only"
        ;;
    21)
        data_yaml_path="${SCRATCH}/data_processed/Global/Annotated/variants/${task}/planet_nearmap_c${imgsz}_ov${overlap}_kf${keep_frac}_10075-single_seed${seed}/data.yaml"
        echo "ℹ Using Planet + Nearmap RGB dataset with 100, 75 single class"
        ;;
    3)
        data_yaml_path="${SCRATCH}/data_processed/Global/Annotated/variants/${task}/nearmap_c${imgsz}_ov${overlap}_kf${keep_frac}_seed${seed}/data.yaml"
        echo "ℹ Using Only Nearmap RGB dataset"
        ;;
    *)
        echo "Error: Invalid multispectral value: ${multispectral}"
        echo "Valid values: 0, 01, 001, 002, 003, 004, 1, 11, 2, 21, 3"
        exit 1
        ;;
esac

if [ ! -f "${data_yaml_path}" ]; then
    echo "Error: Data YAML file not found: ${data_yaml_path}"
    exit 1
fi
echo "✓ Data YAML found: ${data_yaml_path}"
echo "========================================="

echo "GPU information:"
nvidia-smi || echo "Warning: nvidia-smi not available"
echo "========================================="

echo "Setting up Python environment..."
echo "Activating ultralytics_contrib environment..."
if micromamba activate ultralytics_contrib; then
    echo "✓ Environment activated successfully"
else
    echo "⚠ Failed to activate environment"
fi

echo "Final Python: $(which python3)"
echo "Final Python version: $(python3 --version 2>&1)"
echo "Current environment: ${CONDA_DEFAULT_ENV:-system}"
echo "========================================="

if ! command -v yolo >/dev/null 2>&1; then
    echo "Error: 'yolo' command is not available after environment activation"
    exit 1
fi

run_name="$(resolve_run_name)"
if is_nullish "${run_name}"; then
    run_name="yolo_${task}_$(date +%Y%m%d_%H%M%S)"
fi

run_root="${SCRATCH}/runs/cuda/${task}/imgsz_${imgsz}/yolo"
project_dir="${run_root}"
if ! is_nullish "${project}"; then
    project_dir="${run_root}/${project}"
fi
save_dir="${project_dir}/${run_name}"

selected_model="${model_yaml}"
if ! is_nullish "${weights}"; then
    selected_model="${weights}"
fi

wandb_setting="$(bool_string "${wandb}")"
yolo settings "wandb=${wandb_setting}" || true

yolo_args=(
    "task=${task}"
    "mode=train"
    "model=${selected_model}"
    "data=${data_yaml_path}"
    "project=${project_dir}"
    "name=${run_name}"
    "device=${device}"
    "imgsz=${imgsz}"
    "batch=${batch}"
)

append_arg "time" "${time}"
append_arg "epochs" "${epochs}"
append_arg "freeze" "${freeze}"
append_arg "unfreeze" "${unfreeze}"
append_arg "lora" "${lora}"
append_arg "lora_rank" "${lora_rank}"
append_arg "lora_alpha" "${lora_alpha}"
append_arg "lora_dropout" "${lora_dropout}"
append_arg "lora_layers" "${lora_layers}"
append_arg "lora_targets" "${lora_targets}"
append_arg "seed" "${seed}"
append_arg "use_soft_ignore_band" "${use_soft_ignore}"
append_arg "seg_w_dice" "${sdice}"
append_arg "seg_w_bce" "${sbce}"
append_arg "seg_w_lovasz" "${slovhn}"
append_arg "angle_mode" "${angle_mode}"
append_arg "use_land_water_input" "${use_land_water_input}"
append_arg "use_shoreline_input" "${use_shoreline_input}"

append_arg "clahe_p" "${clahe_p}"
append_arg "rand_gamma_p" "${rand_gamma_p}"
append_arg "unsharp_p" "${unsharp_p}"
append_arg "edgeboost_p" "${edgeboost_p}"
append_arg "homomorphic_p" "${homomorphic_p}"
append_arg "gaussian_blur_p" "${gaussian_blur_p}"
append_arg "motion_blur_p" "${motion_blur_p}"
append_arg "additive_noise_p" "${additive_noise_p}"
append_arg "multi_spec_noise_p" "${multi_spec_noise_p}"

append_arg "sobel_p" "${sobel_p}"
append_arg "canny_p" "${canny_p}"
append_arg "log_p" "${log_p}"
append_arg "stt_p" "${structure_tensor_p}"
append_arg "lbp_p" "${lbp_p}"
append_arg "gaussian_pyramid_p" "${gaussian_pyramid_p}"
append_arg "laplacian_pyramid_p" "${laplacian_pyramid_p}"
append_arg "stl_p" "${steerable_p}"
append_arg "gabor_p" "${gabor_p}"
append_arg "dog_p" "${dog_p}"
append_arg "ridge_p" "${ridge_p}"
append_arg "water_depth_indices_p" "${water_indices_p}"

echo "Resolved run name: ${run_name}"
echo "Project directory: ${project_dir}"
echo "Final save dir: ${save_dir}"
echo "WandB setting: ${wandb_setting}"
printf 'Training command: yolo'
for arg in "${yolo_args[@]}"; do
    printf ' %q' "${arg}"
done
printf '\n'
echo "========================================="

if yolo "${yolo_args[@]}"; then
    echo "✅ Training completed successfully at: $(date)"
else
    exit_code=$?
    echo "⚠ Training failed with exit code: ${exit_code} at: $(date)"
    exit "${exit_code}"
fi
